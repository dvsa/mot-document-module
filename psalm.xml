<?xml version="1.0"?>
<psalm
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="https://getpsalm.org/schema/config"
        xsi:schemaLocation="https://getpsalm.org/schema/config vendor-bin/psalm/vendor/vimeo/psalm/config.xsd"
        xmlns:xi="http://www.w3.org/2001/XInclude"
        resolveFromConfigFile="true"
>
    <projectFiles>
        <directory name="module" />
        <directory name="test" test="true"/>
        <ignoreFiles>
            <directory name="config" />
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <plugins>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin" />
    </plugins>
    <issueHandlers>
        <MissingConstructor errorLevel="suppress" />
        <RedundantPropertyInitializationCheck errorLevel="suppress" />
        <PropertyNotSetInConstructor errorLevel="suppress" />
        <UnusedClass>
            <errorLevel type="suppress">
                <directory name="module/DvsaDocument/Factory" errorLevel="info"/>
                <directory name="module/DvsaReport/Service/Factory" errorLevel="info"/>
                <file name="module/DvsaReport/Service/Pdf/PdfRendererFactory.php" errorLevel="info"/>
                <file name="module/DvsaReport/Module.php" errorLevel="info"/>
                <file name="module/DvsaDocument/Mapper/AbstractMapper.php" note="todo: should this class exist" errorLevel="info"/>
            </errorLevel>
        </UnusedClass>
        <PossiblyUnusedMethod>
            <errorLevel type="suppress" note="todo: these methods should probably be removed">
                <directory name="module/*" errorLevel="info" />
            </errorLevel>
        </PossiblyUnusedMethod>
        <PossiblyUnusedReturnValue>
            <errorLevel type="suppress" note="todo: these methods should probably be removed">
                <directory name="module" errorLevel="info" />
            </errorLevel>
        </PossiblyUnusedReturnValue>
        <PossiblyUnusedParam>
            <errorLevel type="suppress" note="todo: this methods should probably be removed">
                <file name="module/DvsaDocument/Mapper/AbstractMapper.php"/>
            </errorLevel>
        </PossiblyUnusedParam>
    </issueHandlers>
</psalm>
