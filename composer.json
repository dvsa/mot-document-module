{
    "name": "dvsa/mot-document-module",
    "description": "Shared Document and Report Generation Module",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "laminas/laminas-mvc": "^3.3.0",
        "laminas/laminas-http": "^2.14",
        "laminas/laminas-servicemanager": "^3.10.0",
        "laminas/laminas-dependency-plugin": "^2.6.0",
        "doctrine/doctrine-module": "^6.3.0",
        "doctrine/doctrine-orm-module": "^6.3.0",
        "dvsa/mot-logger": "^3.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5.9",
        "captainhook/captainhook": "^5.28.4",
        "captainhook/plugin-composer": "^5.3.3",
        "dvsa/coding-standards": "^2.0",
        "phpstan/phpstan": "^2.1.33",
        "vimeo/psalm": "^6.14.3",
        "psalm/plugin-phpunit": "^0.19.5"
    },
    "autoload": {
        "psr-4": {
            "DvsaDocument\\": "module/DvsaDocument/",
            "DvsaReport\\": "module/DvsaReport/",
            "DvsaCommon\\": "module/DvsaCommon/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DvsaDocumentModuleTest\\": "test",
            "DvsaReportModuleTest\\": "test"
        }
    },
    "scripts": {
        "test": [
            "phpunit"
        ],
        "phpcs": "./vendor/bin/phpcs .",
        "phpcs-fix": "./vendor/bin/phpcbf .",
        "psalm": "./vendor/bin/psalm",
        "phpstan": "./vendor/bin/phpstan analyse --memory-limit=512M"
    },
    "config": {
        "platform": {
            "php": "8.2.27"
        },
        "allow-plugins": {
            "laminas/laminas-dependency-plugin": false,
            "captainhook/plugin-composer": true
        }
    }
}
